# Copy to .env.local for local development. In production, set these in the
# Vercel dashboard (Project → Settings → Environment Variables). Never commit
# real values.

# --- Supabase (leave blank to run in demo mode with sample data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI quick chat (server-only) ---
ANTHROPIC_API_KEY=

# --- Lead intake from the marketing site (server-only) ---
LEAD_INTAKE_SECRET=
# CRM_OWNER_EMAIL=phil@valinorgrpllc.com

# --- Public URL, used for link previews and server-side fetches ---
NEXT_PUBLIC_SITE_URL=https://crm.valinorgrp.com

# --- Optional bot protection on sign-in/sign-up (see src/components/auth/turnstile.tsx) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Time zone the schedule uses before the phone's clock takes over ---
# NEXT_PUBLIC_BUSINESS_TIME_ZONE=America/New_York
